rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.email == 'arlyz.s.r@gmail.com';
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isManager() {
      return isSuperAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserRole() == 'MANAGER');
    }

    function isSupervisor() {
      return isManager() || (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserRole() == 'SUPERVISOR');
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Projects collection
    match /projects/{projectId} {
      allow read: if isSignedIn();
      allow write: if isManager();
    }

    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn();
      // Allow user to write their own profile or manager to manage
      allow create: if isSignedIn() && (request.auth.uid == userId || isManager());
      allow update: if isSignedIn() && (
        isManager() || 
        (request.auth.uid == userId && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])))
      );
      allow delete: if isManager();
    }

    // Buildings collection
    match /buildings/{buildingId} {
      allow read: if isSignedIn();
      allow write: if isManager();
    }

    // Work items collection
    match /workItems/{workItemId} {
      allow read: if isSignedIn();
      allow write: if isManager();
    }

    // Daily progress logs
    match /dailyProgress/{progressId} {
      allow read: if isSignedIn();
      // Manager can write directly; supervisor can create submitted drafts
      allow create: if isSignedIn() && (isManager() || (isSupervisor() && request.resource.data.status == 'Submitted'));
      allow update: if isManager();
      allow delete: if isManager();
    }

    // Photo documents
    match /photoDocuments/{photoId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (isManager() || isSupervisor());
      allow update, delete: if isManager();
    }

    // Outstanding Issues
    match /issues/{issueId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (isManager() || isSupervisor());
      allow update: if isSignedIn() && (isManager() || isSupervisor());
      allow delete: if isManager();
    }

    // Audit logs
    match /auditLogs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isManager();
    }

    // Test connection doc
    match /test/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}
