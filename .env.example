# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# FIREBASE CONFIGURATION (Automatically managed in firebase-applet-config.json)
# VITE_FIREBASE_PROJECT_ID="temporal-expanse-xc70r"
# VITE_FIREBASE_AUTH_DOMAIN="temporal-expanse-xc70r.firebaseapp.com"
# VITE_FIREBASE_STORAGE_BUCKET="temporal-expanse-xc70r.firebasestorage.app"
